# Production Environment Variables for ERP
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to Git - it's in .gitignore

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=<generate-strong-random-password>

# ===========================================
# JWT Authentication (REQUIRED)
# Generate with: openssl rand -base64 48
# Must be at least 64 characters for production
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-web
JWT_SIGNING_KEY=<generate-random-base64-string-at-least-64-chars>
JWT_EXPIRATION_MINUTES=60

# ===========================================
# Google Authentication (Optional)
# Enable by setting to 'true' and providing valid Client ID from Google Cloud Console
GOOGLE_AUTHENTICATION_ENABLED=false
GOOGLE_CLIENT_ID=<your-project-id>.apps.googleusercontent.com
EXTERNAL_WORKSPACE_BASE_CURRENCY=USD

# ===========================================
# CORS Configuration (REQUIRED for production)
# Must be your actual production frontend HTTPS domain
# Example: https://erp.yourdomain.com
CORS_ALLOWED_ORIGIN=https://your-production-domain.com

# ===========================================
# Reverse Proxy Configuration
# IP address of the nginx reverse proxy container (Docker internal IP)
# Default works for standard docker-compose networking
REVERSE_PROXY_IP=172.20.0.1

# ===========================================
# Allowed Hosts (REQUIRED for production)
# Your production domain(s), comma-separated
# Example: erp.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=erp.yourdomain.com

# ===========================================
# API Base URL for Frontend Build
# Use /api for same-origin deployment (via nginx proxy)
# Use full HTTPS URL if API is on different domain
API_BASE_URL=/api