{
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "erp-api",
      "Audience": "erp-web",
      "ExpirationMinutes": 60
    },
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "ExternalWorkspace": {
      "BaseCurrencyCode": "USD"
    }
  },
  "Attachments": {
    "StoragePath": "App_Data/attachments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
